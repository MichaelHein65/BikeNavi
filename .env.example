# Diese Vorlage enthält keine echten Zugangsdaten.
# Optionaler kostenloser TomTom-Maps-v1-Zugang (ohne Abrechnung, eigener Schlüssel).
# Maximal 19.000 Routing-Aufrufe/UTC-Monat durch dieses Backend.
TOMTOM_API_KEY=
ORS_API_KEY=
TANKERKOENIG_API_KEY=
GEOAPIFY_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
POI_OVERPASS_URL=
BIKENAVI_TOKEN=
POSTGRES_PASSWORD=
BIKENAVI_PORT=8093
BIKENAVI_SERVER_URL=https://dein-pi.tailnet.ts.net:10443

# Optional: kreative KI-Texte. Ohne beide Werte entstehen HTML-Vorlagenentwürfe.
BLOG_OPENAI_API_KEY=
BLOG_OPENAI_MODEL=
BLOG_WEB_SEARCH=true

# Optional: Auto-Charakter; leer verwendet BLOG_OPENAI_API_KEY/MODEL.
CAR_OPENAI_API_KEY=
CAR_OPENAI_MODEL=
